# ---------------------------------------------------------------------------
# SruNal KZ backend - environment template.
# Copy this file to .env and fill in the values. NEVER commit .env.
# ---------------------------------------------------------------------------

# --- core -------------------------------------------------------------------
APP_ENV=dev
HTTP_ADDR=:8080

# PostgreSQL connection string. The setup script creates this role/database:
#   psql -U postgres -f scripts/setup_db.sql
DATABASE_URL=postgres://srunal:srunal@127.0.0.1:5432/srunal?sslmode=disable

# Browser origins allowed to call the API (the Vite dev server by default).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Public URL of this API (used in file links inside Telegram messages).
PUBLIC_BASE_URL=http://localhost:8080

# Public URL of the web app (links in bot messages and admin notifications).
FRONTEND_BASE_URL=http://localhost:5173

# Trust X-Forwarded-For for the client IP (the per-IP rate limits). Enable it
# ONLY behind a reverse proxy that OVERWRITES the header with the real peer
# address - the bundled Caddyfile does exactly that (header_up X-Forwarded-For
# {remote_host}). Without it every request looks like the proxy's address and
# the limits become global for the whole service.
TRUST_PROXY=true

# Secret used to hash order tokens, session tokens and result links.
# Generate your own: openssl rand -hex 32
TOKEN_PEPPER=

# Panel session lifetime (12h) and the client session opened through the bot
# (30 days: clients stay signed in until they log out or the token expires).
SESSION_TTL=12h
CLIENT_SESSION_TTL=720h
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT=15m

# Where uploaded material, generated documents and the Kaspi QR are stored.
STORAGE_DIR=var/storage
RESULT_TTL=720h

# Import the demo data (10 orders, 11 reviews, 6 promo codes) into an empty
# database on startup. Set to false in production.
SEED_ON_START=true

# Rate limits (requests per client IP).
RATE_LIMIT_ORDERS_PER_HOUR=20
RATE_LIMIT_REVIEWS_PER_HOUR=10
RATE_LIMIT_PROMO_PER_MIN=60
# Order lookups (the six-character order token) per IP and minute.
RATE_LIMIT_ORDER_LOOKUP_PER_MIN=60

# Trust X-Forwarded-For (enable only behind a reverse proxy you control).
TRUST_PROXY=false

# --- generation worker ------------------------------------------------------
WORKER_ENABLED=true
WORKER_POLL_INTERVAL=3s
WORKER_EXPIRE_AFTER=24h
WORKER_STALE_GENERATING_AFTER=30m
WORKER_QUEUE_PAUSED_ON_START=false
# How many orders are generated in parallel (2-3 AI agents) and how many extra
# attempts an order gets after a failed run.
WORKER_MAX_AGENTS=3
WORKER_AGENT_RETRIES=1

# --- document generation ----------------------------------------------------
# Generator used after the operator confirms a payment:
#   agent   - the external AI agent CLI (Cline), see GENERATOR_COMMAND
#   auto    - the agent when the command resolves, otherwise the built-in writer
#   builtin - the bundled .docx writer only (demo, no AI)
GENERATOR_MODE=agent
GENERATOR_COMMAND=cline
# Extra CLI arguments, e.g. -m opencode-go/deepseek-v4.1-flash
GENERATOR_EXTRA_ARGS=
# Pinned model for every run: provider, model and reasoning effort
# (low|medium|high|xhigh). Defaults: opencode-go / deepseek-v4.1-flash / high.
GENERATOR_PROVIDER=opencode-go
GENERATOR_MODEL=deepseek-v4.1-flash
GENERATOR_THINKING=high
# Optional BYOK key: when set it is exported to the agent process under the
# provider's key variable - opencode-go -> OPENCODE_API_KEY, deepseek ->
# DEEPSEEK_API_KEY, openai -> OPENAI_API_KEY, ... Not needed when the CLI already
# holds the credentials from `cline auth` / providers.json.
GENERATOR_API_KEY=
# Override the variable name(s), comma-separated, e.g. OPENCODE_API_KEY.
GENERATOR_API_KEY_ENV=
# Where the agent CLI keeps its configuration and state. Leave empty for the
# default location; in Docker both point at the /data volume and the provider
# credentials live in /data/cline/settings/providers.json:
#   GENERATOR_CONFIG_DIR=/data/cline
#   GENERATOR_DATA_DIR=/data/cline
GENERATOR_CONFIG_DIR=
GENERATOR_DATA_DIR=
# One order must finish inside this window; each order gets its own work dir.
GENERATOR_TIMEOUT=20m
GENERATOR_DIR=var/generator

# Global agent skills (agent-skills layout: <dir>/<skill>/SKILL.md).
# On Windows: C:\Users\<you>\.agents\skills ; on Linux: ~/.agents/skills
SKILL_SOURCE_DIR=~/.agents/skills
GENERATOR_SKILL_GOST=satbayev-gost   # essay / lab / other
GENERATOR_SKILL_PPTX=pptx            # presentation

# --- Telegram bot -----------------------------------------------------------
# THE BOT KEY GOES HERE: paste the token you got from @BotFather.
# 1. Open Telegram, write to @BotFather, send /newbot and follow the steps.
# 2. BotFather answers with a token like 123456789:AAH3x... - paste it below.
# 3. Set TELEGRAM_BOT_ENABLED=true and restart the API.
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=

# Bot handle without @ (used for deep links and t.me hints).
TELEGRAM_BOT_USERNAME=srunal_bot

# Chat IDs of operators that should receive notifications without /bind.
# How to find your own id (any of the three ways):
#   1. Send /id to your bot - it answers with the exact number to paste here.
#   2. Write to @userinfobot (or @getmyid_bot) - it replies with your id.
#   3. Add the bot to a group first, then send /id in the group; group ids look
#      like -1001234567890 and personal ids look like 123456789.
# Several ids are comma-separated: TELEGRAM_ADMIN_CHAT_IDS=123456789,-1001234567890
# Alternative that needs no id at all: send /bind @operator_almaty <password>
# to the bot - the chat is then linked to the operator automatically.
TELEGRAM_ADMIN_CHAT_IDS=

# Long-polling timeout and housekeeping.
TELEGRAM_POLL_TIMEOUT=25s

# --- Telegram Mini App -------------------------------------------------------
# Built Mini App (../miniapp: npm run build). When MINIAPP_DIR points at a
# directory with index.html, the API serves the SPA on every non-/api route,
# so one HTTPS origin covers both the API and the app.
MINIAPP_DIR=../miniapp/dist

# Short name of the Mini App created in @BotFather (t.me/<bot>/<short_name>,
# also the menu-button target). Used to build deep links inside notifications,
# e.g. https://t.me/srunal_bot/srunal?startapp=order_DG-260391
TELEGRAM_MINIAPP_SHORT_NAME=

# Deployment variables for docker compose (this file is read next to the
# compose file). Copy to `deploy/.env` and fill in — it never holds secrets of
# the application itself (those live in backend/.env).

# Public HTTPS domain of the deployment. With DuckDNS create a subdomain at
# https://www.duckdns.org and point its IP at this server, then put the name
# here WITHOUT the scheme: srunal-kz.duckdns.org
DOMAIN=

# Optional: e-mail for Let's Encrypt expiry notices.
ACME_EMAIL=

# Password of the internal PostgreSQL (compose creates it on the first run;
# change it before the first start).
POSTGRES_PASSWORD=

# Loopback port of the API (http://127.0.0.1:<port> on the server only).
API_PORT=8080

# agent = the AI CLI (recommended in production); auto = fall back to the
# built-in .docx writer when the CLI is not usable.
GENERATOR_MODE=agent
